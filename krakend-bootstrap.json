{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "quantum-bank-bootstrap-gateway",
  "_pqc_transport_note": "KrakenD listens on loopback only. The post-quantum HAProxy terminator in the same network namespace (tls/haproxy-*.cfg) owns every TLS socket: ML-DSA certificates, X25519MLKEM768 key exchange, app-to-gateway mTLS on the banking listener and gateway-to-backend mTLS on 127.0.0.1:18081. Go crypto/tls has no ML-DSA support, so KrakenD must not terminate TLS itself.",
  "listen_ip": "127.0.0.1",
  "port": 18080,
  "timeout": "10s",
  "read_header_timeout": "5s",
  "read_timeout": "15s",
  "idle_timeout": "60s",
  "extra_config": {
    "security/http": {
      "frame_deny": true,
      "content_type_nosniff": true,
      "browser_xss_filter": true,
      "sts_seconds": 31536000,
      "sts_include_subdomains": true,
      "referrer_policy": "no-referrer"
    },
    "router": {
      "disable_health": false,
      "hide_version_header": true,
      "logger_skip_paths": [
        "/__health"
      ]
    }
  },
  "endpoints": [
    {
      "endpoint": "/auth/otk",
      "method": "POST",
      "timeout": "10s",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://127.0.0.1:18082/realms/quantum-bank-local/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "https://keycloak:8443/realms/quantum-bank-local",
          "audience": [
            "quantum-bank-api"
          ],
          "cache": true,
          "cache_duration": 900,
          "scopes_key": "scope",
          "scopes_matcher": "all",
          "operation_debug": false,
          "scopes": [
            "profile:read"
          ]
        },
        "qos/ratelimit/router": {
          "max_rate": 20,
          "capacity": 20,
          "client_max_rate": 5,
          "client_capacity": 5,
          "strategy": "ip",
          "every": "1s"
        }
      },
      "backend": [
        {
          "host": [
            "http://127.0.0.1:18081"
          ],
          "url_pattern": "/auth/otk",
          "method": "POST",
          "encoding": "no-op"
        }
      ],
      "input_headers": [
        "Authorization",
        "Content-Type",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op"
    },
    {
      "endpoint": "/auth/csr",
      "method": "POST",
      "timeout": "10s",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://127.0.0.1:18082/realms/quantum-bank-local/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "https://keycloak:8443/realms/quantum-bank-local",
          "audience": [
            "quantum-bank-api"
          ],
          "cache": true,
          "cache_duration": 900,
          "scopes_key": "scope",
          "scopes_matcher": "all",
          "operation_debug": false,
          "scopes": [
            "profile:read"
          ]
        },
        "qos/ratelimit/router": {
          "max_rate": 10,
          "capacity": 10,
          "client_max_rate": 3,
          "client_capacity": 3,
          "strategy": "ip",
          "every": "1s"
        }
      },
      "backend": [
        {
          "host": [
            "http://127.0.0.1:18081"
          ],
          "url_pattern": "/auth/csr",
          "method": "POST",
          "encoding": "no-op"
        }
      ],
      "input_headers": [
        "Authorization",
        "Content-Type",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op"
    }
  ]
}
