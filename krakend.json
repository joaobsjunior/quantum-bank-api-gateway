{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "quantum-bank-api-gateway-bootstrap-compat",
  "port": 8080,
  "timeout": "10s",
  "read_header_timeout": "5s",
  "read_timeout": "15s",
  "idle_timeout": "60s",
  "tls": {
    "keys": [
      {
        "public_key": "/etc/krakend/tls/gateway-server.crt",
        "private_key": "/etc/krakend/tls/gateway-server.key"
      }
    ],
    "min_version": "TLS13"
  },
  "client_tls": {
    "ca_certs": [
      "/etc/krakend/trust/root-ca.crt"
    ],
    "client_certs": [
      {
        "certificate": "/etc/krakend/tls/gateway-client.crt",
        "private_key": "/etc/krakend/tls/gateway-client.key"
      }
    ]
  },
  "extra_config": {
    "security/http": {
      "frame_deny": true,
      "content_type_nosniff": true,
      "browser_xss_filter": true,
      "sts_seconds": 31536000,
      "sts_include_subdomains": true,
      "referrer_policy": "no-referrer"
    },
    "router": {
      "disable_health": false,
      "hide_version_header": true,
      "logger_skip_paths": [
        "/__health"
      ]
    }
  },
  "_phase3_mtls_note": "Compatibility entrypoint only. Phase 3 uses krakend-bootstrap.json for OAuth2-only bootstrap and krakend-banking.json for OAuth2 plus app-to-gateway mTLS banking routes.",
  "endpoints": [
    {
      "endpoint": "/auth/otk",
      "method": "POST",
      "timeout": "10s",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "https://keycloak:8443/realms/quantum-bank-local/protocol/openid-connect/certs",
          "jwk_local_ca": "/etc/krakend/trust/root-ca.crt",
          "issuer": "https://keycloak:8443/realms/quantum-bank-local",
          "audience": [
            "quantum-bank-api"
          ],
          "cache": true,
          "cache_duration": 900,
          "scopes_key": "scope",
          "scopes_matcher": "all",
          "scopes": [
            "profile:read"
          ],
          "operation_debug": false
        },
        "qos/ratelimit/router": {
          "max_rate": 20,
          "capacity": 20,
          "client_max_rate": 5,
          "client_capacity": 5,
          "strategy": "ip",
          "every": "1s"
        }
      },
      "backend": [
        {
          "host": [
            "https://backend:8080"
          ],
          "url_pattern": "/auth/otk",
          "method": "POST",
          "encoding": "no-op"
        }
      ],
      "input_headers": [
        "Authorization",
        "Content-Type",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op"
    },
    {
      "endpoint": "/auth/csr",
      "method": "POST",
      "timeout": "10s",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "https://keycloak:8443/realms/quantum-bank-local/protocol/openid-connect/certs",
          "jwk_local_ca": "/etc/krakend/trust/root-ca.crt",
          "issuer": "https://keycloak:8443/realms/quantum-bank-local",
          "audience": [
            "quantum-bank-api"
          ],
          "cache": true,
          "cache_duration": 900,
          "scopes_key": "scope",
          "scopes_matcher": "all",
          "scopes": [
            "profile:read"
          ],
          "operation_debug": false
        },
        "qos/ratelimit/router": {
          "max_rate": 10,
          "capacity": 10,
          "client_max_rate": 3,
          "client_capacity": 3,
          "strategy": "ip",
          "every": "1s"
        }
      },
      "backend": [
        {
          "host": [
            "https://backend:8080"
          ],
          "url_pattern": "/auth/csr",
          "method": "POST",
          "encoding": "no-op"
        }
      ],
      "input_headers": [
        "Authorization",
        "Content-Type",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op"
    }
  ]
}
